# Biến môi trường tùy chọn cho CN Video Scraper Pro.
# Có thể nhập API Key trực tiếp trong tab "🤖 Tích hợp AI" (lưu ở config/ai_secrets.json, quyền 0600).
# Biến môi trường chỉ được dùng khi chưa nhập key trong giao diện.

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# OpenAI ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Nhà cung cấp tương thích OpenAI (DeepSeek, Groq, OpenRouter...) — Base URL cấu hình trong giao diện
CN_OPENAI_COMPAT_API_KEY=

# Cổng backend (mặc định 3889)
PORT=3889
